---
interface Props { value: string; label: string }
const { value, label } = Astro.props;
---
<!-- Phones: value and label on one line so three tiles don't fill the first screen. -->
<div class="flex items-baseline gap-3 rounded-md border border-zinc-200 bg-white px-4 py-3 sm:block sm:p-4 dark:border-zinc-800 dark:bg-zinc-900">
  <p class="text-lg font-semibold text-emerald-700 sm:text-xl dark:text-emerald-400">{value}</p>
  <p class="text-xs text-zinc-600 sm:mt-1 sm:text-sm dark:text-zinc-400">{label}</p>
</div>
