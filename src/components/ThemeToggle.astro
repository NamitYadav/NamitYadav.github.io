---
const themes = [
  ['dark', 'Dark'],
  ['light', 'Light'],
  ['gruvbox', 'Gruvbox'],
  ['gruvbox-light', 'Gruvbox light'],
] as const;
---
<label class="flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
  <span class="sr-only">Theme</span>
  <select
    id="theme-select"
    class="min-h-9 rounded border border-zinc-300 bg-transparent px-2 py-1 text-xs text-zinc-600 hover:border-zinc-500 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-500"
  >
    {themes.map(([value, label]) => <option value={value}>{label}</option>)}
  </select>
</label>
<script is:inline>
  (function () {
    var root = document.documentElement;
    var select = document.getElementById('theme-select');
    // Theme->color map duplicated in Base.astro; keep both in sync.
    var themeColors = { dark: '#09090b', light: '#fafafa', gruvbox: '#1d2021', 'gruvbox-light': '#fbf1c7' };
    function sync() {
      select.value = root.dataset.theme || 'dark';
      var meta = document.querySelector('meta[name="theme-color"]');
      if (meta) meta.setAttribute('content', themeColors[root.dataset.theme] || themeColors.dark);
    }
    select.addEventListener('change', function () {
      root.dataset.theme = select.value;
      try { localStorage.setItem('portfolio:theme', select.value); } catch (e) {}
      sync();
    });
    sync();
  })();
</script>
