---
const themes = [
  ['system', 'System'],
  ['gruvbox', 'Gruvbox'],
  ['gruvbox-light', 'Gruvbox light'],
  ['dark', 'Dark'],
  ['light', 'Light'],
] as const;
---
<label class="flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
  <span class="sr-only">Theme</span>
  <select
    id="theme-select"
    class="min-h-9 rounded border border-zinc-300 bg-transparent px-2 py-1 text-xs text-zinc-600 hover:border-zinc-500 dark:border-zinc-700 dark:text-zinc-400 dark:hover:border-zinc-500"
  >
    {themes.map(([value, label]) => <option value={value}>{label}</option>)}
  </select>
</label>
<script is:inline>
  (function () {
    var select = document.getElementById('theme-select');
    try { select.value = localStorage.getItem('portfolio:theme') || 'system'; } catch (e) {}
    if (!select.value) select.value = 'system';
    select.addEventListener('change', function () {
      try {
        if (select.value === 'system') localStorage.removeItem('portfolio:theme');
        else localStorage.setItem('portfolio:theme', select.value);
      } catch (e) {}
      window.applyTheme(select.value);
    });
  })();
</script>
